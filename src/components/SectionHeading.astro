---
interface Props {
	id: string;
	number: string;
	title: string;
	sample?: boolean;
}
const { id, number, title, sample = false } = Astro.props;
---

<div class="section-heading">
	<h2 id={id}><span aria-hidden="true">{number} /</span> {title}</h2>
	{sample && <small>サンプル</small>}
</div>

<style>
	.section-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		margin-bottom: 1rem;
	}
	h2 {
		margin: 0;
		font-size: 1.625rem;
		font-weight: 600;
		line-height: var(--line-height-heading);
	}
	h2 span {
		margin-right: 0.375rem;
		color: var(--color-accent);
		font-size: var(--font-size-small);
		font-weight: 500;
	}
	small {
		color: var(--color-muted);
		font-size: 0.75rem;
	}
</style>
